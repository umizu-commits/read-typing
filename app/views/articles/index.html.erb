<% content_for :title, "保存記事 | ReadTyping" %>

<div class="w-full py-4 max-w-4xl mx-auto">

  <%# タイトル %>
  <div class="mb-4">
    <h1 class="text-2xl font-bold text-gray-100">保存記事</h1>
    <p class="text-sm text-gray-400 mt-1">保存した記事の一覧です。タイピング練習に使った記事を再利用できます。</p>
  </div>

  <%# 記事一覧（Turbo Frame でページネーション時にスクロール位置維持） %>
  <turbo-frame id="articles-list" data-turbo-action="advance" class="block">

  <%# 検索・並び替えエリア %>
  <div class="bg-gray-900 rounded-xl border border-gray-800 shadow-sm mb-4" data-controller="disclosure">

    <%# 検索フォーム %>
    <div class="flex items-center gap-2 px-4 pt-3 pb-3">
      <%= form_with url: articles_path, method: :get, data: { turbo_frame: "articles-list" }, class: "flex items-center gap-2 flex-1" do |f| %>
        <%= f.hidden_field :sort, value: @current_sort %>
        <%= f.hidden_field :category, value: @current_category %>
        <%= f.hidden_field :tag, value: @current_tag %>
        <%= f.text_field :q, value: @current_keyword, placeholder: "タイトル・URLで検索",
            class: "flex-1 border border-gray-700 bg-gray-800 text-gray-100 placeholder-gray-500 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-500" %>
        <%= f.submit "検索",
            class: "bg-green-500 hover:bg-green-700 text-gray-950 px-4 py-2 rounded-lg text-sm font-bold transition-colors cursor-pointer" %>
      <% end %>
      <% if @current_keyword.present? %>
        <%= link_to "クリア", articles_path(sort: @current_sort),
            data: { turbo_frame: "articles-list" },
            class: "inline-flex items-center border border-gray-700 text-gray-400 hover:bg-gray-800 px-4 py-2 rounded-lg text-sm font-bold transition-colors" %>
      <% end %>
    </div>

    <%# トグルボタン %>
    <button data-action="click->disclosure#toggle"
            class="w-full flex items-center justify-end gap-2 px-4 py-2.5 text-sm font-bold text-gray-400 hover:bg-gray-800 border-t border-gray-800 transition-colors">
      <span>≡ 検索オプション</span>
      <svg data-disclosure-target="icon" class="w-4 h-4 text-gray-500 transition-transform duration-200"
           fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      </svg>
    </button>

    <%# 折りたたみコンテンツ（デフォルトで非表示） %>
    <div data-disclosure-target="content" class="hidden px-4 pb-4">

      <%# 並び替えボタン %>
      <div class="flex items-center gap-2 mt-3 pt-3 border-t border-gray-800">
        <span class="text-xs text-gray-400 font-bold shrink-0">並び替え：</span>
        <% Article::SORT_OPTIONS.each_key do |key| %>
          <%= link_to Article::SORT_LABELS[key], articles_path(sort: key, q: @current_keyword),
              data: { turbo_frame: "articles-list" },
              class: "px-3 py-1.5 rounded-lg text-xs font-bold transition-colors #{key == @current_sort ? 'bg-green-700 text-gray-950' : 'border border-gray-700 text-gray-400 hover:bg-gray-800'}" %>
        <% end %>
      </div>

      <%# カテゴリフィルター %>
      <div class="flex items-center gap-2 mt-3 pt-3 border-t border-gray-800">
        <span class="text-xs text-gray-400 font-bold shrink-0">カテゴリ：</span>
        <%= link_to "すべて", articles_path(sort: @current_sort, q: @current_keyword),
            data: { turbo_frame: "articles-list" },
            class: "px-3 py-1.5 rounded-lg text-xs font-bold transition-colors #{@current_category.blank? ? 'bg-green-700 text-gray-950' : 'border border-gray-700 text-gray-400 hover:bg-gray-800'}" %>
        <% Article::CATEGORIES.each do |value, label| %>
          <%= link_to label, articles_path(sort: @current_sort, q: @current_keyword, category: value),
              data: { turbo_frame: "articles-list" },
              class: "px-3 py-1.5 rounded-lg text-xs font-bold transition-colors #{@current_category == value ? 'bg-green-700 text-gray-950' : 'border border-gray-700 text-gray-400 hover:bg-gray-800'}" %>
        <% end %>
      </div>

      <%# タグフィルター %>
      <% all_tags = policy_scope(Article).joins(:tags).distinct.pluck("tags.name").sort %>
      <% if all_tags.any? %>
        <div class="flex flex-wrap items-center gap-2 mt-3 pt-3 border-t border-gray-800">
          <span class="text-xs text-gray-400 font-bold shrink-0">タグ：</span>
          <% if @current_tag.present? %>
            <%= link_to "× #{@current_tag}", articles_path(sort: @current_sort, q: @current_keyword, category: @current_category),
                data: { turbo_frame: "articles-list" },
                class: "px-3 py-1.5 rounded-lg text-xs font-bold transition-colors bg-green-700 text-gray-950" %>
          <% else %>
            <% all_tags.each do |tag_name| %>
              <%= link_to tag_name, articles_path(sort: @current_sort, q: @current_keyword, category: @current_category, tag: tag_name),
                  data: { turbo_frame: "articles-list" },
                  class: "px-3 py-1.5 rounded-lg text-xs font-bold transition-colors border border-gray-700 text-gray-400 hover:bg-gray-800" %>
            <% end %>
          <% end %>
        </div>
      <% end %>

      <%# お気に入りフィルター %>
      <div class="flex items-center gap-2 mt-3 pt-3 border-t border-gray-800">
        <span class="text-xs text-gray-400 font-bold shrink-0">絞り込み：</span>
        <%= link_to "★ お気に入りのみ",
            articles_path(sort: @current_sort, q: @current_keyword, category: @current_category, tag: @current_tag, favorites_only: !@current_favorites_only),
            data: { turbo_frame: "articles-list" },
            class: "px-3 py-1.5 rounded-lg text-xs font-bold transition-colors #{@current_favorites_only ? 'bg-yellow-500 text-gray-950' : 'border border-gray-700 text-gray-400 hover:bg-gray-800'}" %>
      </div>
    </div>

  <div class="bg-gray-900 rounded-xl border border-gray-800 shadow-sm overflow-hidden">
    <% if @articles.empty? %>
      <% if @current_keyword.present? %>
        <%# 検索結果が0件のとき %>
        <div class="p-10 text-center">
          <svg class="w-16 h-16 mx-auto text-gray-600 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
          </svg>
          <p class="text-sm font-bold text-gray-200 mb-1">"<%= @current_keyword %>" に一致する記事が見つかりませんでした</p>
          <%= link_to "検索をクリア", articles_path(sort: @current_sort),
              data: { turbo_frame: "articles-list" },
              class: "inline-flex items-center gap-2 rounded-lg border border-gray-700 text-gray-400 hover:bg-gray-800 px-6 py-2.5 text-sm font-bold shadow-sm" %>
        </div>
      <% else %>
        <%# 記事が1件も保存されていないとき %>
        <div class="p-10 text-center">
          <svg class="w-16 h-16 mx-auto text-gray-600 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
          </svg>
          <p class="text-sm font-bold text-gray-200 mb-1">保存された記事がありません</p>
          <p class="text-xs text-gray-400 mb-5">トップページから記事を保存すると、ここに表示されます。</p>
          <%= link_to root_path,
              data: { turbo_frame: "_top" },
              class: "inline-flex items-center gap-2 rounded-lg bg-green-500 hover:bg-green-700 px-6 py-2.5 text-sm font-bold text-gray-950 shadow-sm" do %>
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
            </svg>
            トップへ戻る
          <% end %>
        </div>
      <% end %>
    <% else %>
      <ul class="divide-y divide-gray-800">
        <% @articles.each do |article| %>
          <li class="px-6 py-4 hover:bg-gray-800 flex items-center justify-between gap-4">
            <div class="min-w-0 flex-1">
              <%= link_to article_path(article),
                data: { turbo_frame: "_top" },
                class: "text-base font-bold text-gray-100 truncate hover:text-green-500 hover:underline transition-colors block" do %>
              <%= article.title.presence || "タイトルなし" %>
            <% end %>
              <% if article.category.present? %>
                <span class="inline-block mt-1 px-2 py-0.5 rounded text-xs font-bold bg-green-900 text-green-500">
                  <%= Article::CATEGORIES[article.category] %>
                </span>
              <% end %>
              <% article.tags.each do |tag| %>
                <%= link_to tag.name,
                articles_path(sort: @current_sort, q: @current_keyword, category: @current_category, tag: tag.name),
                data: { turbo_frame: "articles-list" },
                class: "inline-block mt-1 mr-1 px-2 py-0.5 rounded text-xs font-bold bg-gray-700 text-gray-300 hover:bg-gray-600 transition-colors" %>
              <% end %>
              <% if article.url? %>
                <a href="<%= article.url %>" target="_blank" rel="noopener noreferrer"
                   class="text-xs text-green-500 hover:underline truncate block mt-1">
                  <%= article.url %>
                </a>
              <% else %>
                <span class="text-xs text-gray-500 mt-1 block">テキスト入力</span>
              <% end %>
              <p class="text-xs text-gray-500 mt-1">
                保存日時：<%= article.created_at.strftime("%Y-%m-%d %H:%M") %>
              </p>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <%= render "favorite_button", article: article, favorited: current_user.favorite_articles.include?(article) %>

              <%= link_to typing_path(article_id: article.id),
                  data: { turbo_frame: "_top" },
                  class: "inline-flex items-center gap-1.5 bg-green-500 hover:bg-green-700 text-gray-950 text-sm font-bold px-4 py-2 rounded-lg transition-colors" do %>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                練習を開始
              <% end %>
              <%= link_to edit_article_path(article),
                  data: { turbo_frame: "_top" },
                  class: "inline-flex items-center gap-1 text-sm text-gray-400 hover:text-gray-200 font-bold px-3 py-2 rounded-lg hover:bg-gray-700 transition-colors" do %>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                </svg>
                編集
              <% end %>
              <%= link_to article_path(article),
                  data: { turbo_method: :delete, turbo_confirm: "この記事を削除しますか？" },
                  class: "inline-flex items-center gap-1 text-sm text-red-400 hover:text-red-300 font-bold px-3 py-2 rounded-lg hover:bg-red-950 transition-colors" do %>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
                削除
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>

      <%# 件数表示 %>
      <div class="px-5 py-3 border-t border-gray-800 text-xs text-gray-500 text-center">
        全 <%= @articles.total_count %> 件中 <%= @articles.offset_value + 1 %>-<%= [@articles.offset_value + 20, @articles.total_count].min %> を表示中
      </div>

      <%# ページネーション %>
      <% if @articles.total_pages > 1 %>
        <div class="px-5 py-3 border-t border-gray-800">
          <%= paginate @articles, window: 2, outer_window: 1 %>
        </div>
      <% end %>
    <% end %>
  </div>
  </turbo-frame>
</div>
