<% content_for :title, "保存記事 | ReadTyping" %>

<div class="w-full py-4 max-w-4xl mx-auto">

  <%# タイトル %>
  <div class="mb-4">
    <h1 class="text-2xl font-bold text-gray-800">保存記事</h1>
    <p class="text-sm text-gray-500 mt-1">URLから取得した記事の一覧です。タイピング練習に使った記事を再利用できます。</p>
  </div>

  <%# 記事一覧（Turbo Frame でページネーション時にスクロール位置維持） %>
  <turbo-frame id="articles-list" data-turbo-action="advance" class="block">
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <% if @articles.empty? %>
      <div class="p-10 text-center">
        <p class="text-sm font-bold text-gray-700 mb-1">保存された記事がありません</p>
        <p class="text-xs text-gray-500 mb-5">トップページのURLフォームから記事を取得すると、ここに表示されます。</p>
        <%= link_to root_path,
            data: { turbo_frame: "_top" },
            class: "inline-flex items-center gap-2 rounded-lg bg-blue-500 hover:bg-blue-600 px-6 py-2.5 text-sm font-bold text-white shadow-sm" do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          トップへ戻る
        <% end %>
      </div>
    <% else %>
      <ul class="divide-y divide-gray-100">
        <% @articles.each do |article| %>
          <li class="px-6 py-4 hover:bg-gray-50 flex items-center justify-between gap-4">
            <div class="min-w-0 flex-1">
              <p class="text-base font-bold text-gray-800 truncate">
                <%= article.title.presence || "タイトルなし" %>
              </p>
              <a href="<%= article.url %>" target="_blank" rel="noopener noreferrer"
                 class="text-xs text-blue-500 hover:underline truncate block mt-1">
                <%= article.url %>
              </a>
              <p class="text-xs text-gray-400 mt-1">
                保存日時：<%= article.created_at.strftime("%Y-%m-%d %H:%M") %>
              </p>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <%= link_to typing_path(article_id: article.id),
                  data: { turbo_frame: "_top" },
                  class: "inline-flex items-center gap-1.5 bg-blue-500 hover:bg-blue-600 text-white text-sm font-bold px-4 py-2 rounded-lg transition-colors" do %>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                練習を開始
              <% end %>
              <%= link_to article_path(article),
                  data: { turbo_method: :delete, turbo_confirm: "この記事を削除しますか？" },
                  class: "inline-flex items-center gap-1 text-sm text-red-500 hover:text-red-600 font-bold px-3 py-2 rounded-lg hover:bg-red-50 transition-colors" do %>
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                </svg>
                削除
              <% end %>
            </div>
          </li>
        <% end %>
      </ul>

      <%# 件数表示 %>
      <div class="px-5 py-3 border-t border-gray-100 text-xs text-gray-400 text-center">
        全 <%= @articles.total_count %> 件中 <%= @articles.offset_value + 1 %>-<%= [@articles.offset_value + 20, @articles.total_count].min %> を表示中
      </div>

      <%# ページネーション %>
      <% if @articles.total_pages > 1 %>
        <div class="px-5 py-3 border-t border-gray-100">
          <%= paginate @articles, window: 2, outer_window: 1 %>
        </div>
      <% end %>
    <% end %>
  </div>
  </turbo-frame>

</div>
