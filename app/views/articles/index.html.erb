<% content_for :title, "保存記事 | ReadTyping" %>

<div class="py-4 max-w-4xl mx-auto">

  <%# タイトル %>
  <div class="mb-4">
    <h1 class="text-2xl font-bold text-gray-800">保存記事</h1>
    <p class="text-sm text-gray-500 mt-1">URLから取得した記事の一覧です。タイピング練習に使った記事を再利用できます。</p>
  </div>

  <%# 記事一覧 %>
  <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
    <% if @articles.empty? %>
      <div class="p-10 text-center text-sm text-gray-500">
        保存された記事がありません。<br>
        トップページのURLフォームから記事を取得するとここに表示されます。
      </div>
    <% else %>
      <ul class="divide-y divide-gray-100">
        <% @articles.each do |article| %>
          <li class="px-6 py-4 hover:bg-gray-50 flex items-center justify-between gap-4">
            <div class="min-w-0 flex-1">
              <p class="text-sm font-bold text-gray-800 truncate">
                <%= article.title.presence || "タイトルなし" %>
              </p>
              <a href="<%= article.url %>" target="_blank" rel="noopener noreferrer"
                 class="text-xs text-blue-500 hover:underline truncate block mt-0.5">
                <%= article.url %>
              </a>
              <p class="text-xs text-gray-400 mt-1">
                保存日時：<%= article.created_at.strftime("%Y-%m-%d %H:%M") %>
              </p>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <%= link_to "練習を開始", typing_path(article_id: article.id),
                    class: "bg-blue-400 hover:bg-blue-500 text-white text-xs font-bold px-4 py-2 rounded-lg transition-colors" %>
              <%= link_to "削除", article_path(article),
                   data: { turbo_method: :delete, turbo_confirm: "この記事を削除しますか？" },
                    class: "text-xs text-red-400 hover:text-red-600 font-bold px-3 py-2 rounded-lg hover:bg-red-50 transition-colors" %>
            </div>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>

</div>