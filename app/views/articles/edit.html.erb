<% content_for :title, "記事を編集 | ReadTyping" %>

<div class="w-full py-4 max-w-2xl mx-auto">
  <div class="mb-4">
    <h1 class="text-2xl font-bold text-gray-800">記事を編集</h1>
    <p class="text-sm text-gray-500 mt-1">タイトル・本文・カテゴリ・タグを編集できます。</p>
  </div>

  <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-6">
    <%= form_with url: article_path(@article), method: :patch do |f| %>

      <%# エラーメッセージ %>
      <% if @form.errors.any? %>
        <div class="mb-4 p-4 bg-red-50 border border-red-200 rounded-lg">
          <ul class="list-disc list-inside text-sm text-red-600 space-y-1">
            <% @form.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%# タイトル %>
      <div class="mb-4">
        <label class="block text-sm font-bold text-gray-700 mb-1">タイトル</label>
        <%= f.text_field :title, value: @form.title,
            class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-300 focus:border-transparent",
            placeholder: "タイトル（省略可）" %>
      </div>

      <%# カテゴリ %>
      <div class="mb-4">
        <label class="block text-sm font-bold text-gray-700 mb-1">カテゴリ</label>
        <%= f.select :category,
            Article::CATEGORIES.map { |value, label| [label, value] },
            { include_blank: "未設定", selected: @form.category },
            class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-300 focus:border-transparent" %>
      </div>

      <%# タグ %>
      <div class="mb-4">
        <label class="block text-sm font-bold text-gray-700 mb-1">タグ</label>
        <%= f.text_field :tag_names, value: @form.tag_names,
            class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-300 focus:border-transparent",
            placeholder: "カンマ区切りで入力（例: Ruby, Rails）" %>
        <p class="text-xs text-gray-400 mt-1">複数のタグはカンマ（,）で区切ってください。空欄にするとタグが削除されます。</p>
      </div>

      <%# 本文 %>
      <div class="mb-4">
        <label class="block text-sm font-bold text-gray-700 mb-1">本文</label>
        <%= f.text_area :body, value: @form.body,
            rows: 12,
            class: "w-full border border-gray-200 rounded-lg px-3 py-2 text-sm text-gray-700 focus:outline-none focus:ring-2 focus:ring-blue-300 focus:border-transparent font-mono",
            placeholder: "本文を入力してください（50〜10,000文字）" %>
      </div>

      <%# ボタン %>
      <div class="flex items-center justify-end gap-3 mt-6 pt-4 border-t border-gray-100">
        <%= link_to "キャンセル", articles_path,
            class: "text-sm font-bold text-gray-600 hover:text-gray-800 px-4 py-2 rounded-lg hover:bg-gray-100 transition-colors" %>
        <%= f.submit "更新する",
            class: "bg-blue-500 hover:bg-blue-600 text-white text-sm font-bold px-6 py-2 rounded-lg transition-colors cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>