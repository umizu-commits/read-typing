<% content_for :title, "#{@article.title.presence || 'タイトルなし'} | ReadTyping" %>

<div class="w-full py-4 max-w-2xl mx-auto">
  <div class="mb-4 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-100"><%= @article.title.presence || "タイトルなし" %></h1>
      <p class="text-xs text-gray-500 mt-1">保存日時：<%= @article.created_at.strftime("%Y-%m-%d %H:%M") %></p>
    </div>
    <%= link_to "一覧に戻る", articles_path,
        class: "text-sm font-bold text-gray-400 hover:text-gray-200 px-4 py-2 rounded-lg hover:bg-gray-800 transition-colors shrink-0" %>
  </div>

  <div class="bg-gray-900 rounded-xl border border-gray-800 shadow-xl ring-1 ring-white/5 p-6 space-y-5">

    <%# カテゴリ・タグ %>
    <div class="flex flex-wrap items-center gap-2">
      <% if @article.category.present? %>
        <span class="px-2 py-0.5 rounded text-xs font-bold bg-green-900 text-green-500">
          <%= Article::CATEGORIES[@article.category] %>
        </span>
      <% end %>
      <% @article.tags.each do |tag| %>
        <span class="px-2 py-0.5 rounded text-xs font-bold bg-gray-700 text-gray-300">
          <%= tag.name %>
        </span>
      <% end %>
      <% if @article.category.blank? && @article.tags.empty? %>
        <span class="text-xs text-gray-500">カテゴリ・タグなし</span>
      <% end %>
    </div>

    <%# 元URL %>
    <% if @article.url? %>
      <div>
        <p class="text-xs font-bold text-gray-400 mb-1">元記事URL</p>
        <a href="<%= @article.url %>" target="_blank" rel="noopener noreferrer"
           class="text-xs text-green-500 hover:underline break-all">
          <%= @article.url %>
        </a>
      </div>
    <% end %>

    <%# 本文 %>
    <div>
      <p class="text-xs font-bold text-gray-400 mb-2">本文</p>
      <div class="bg-gray-800 rounded-lg p-4 text-sm text-gray-300 whitespace-pre-wrap font-mono leading-relaxed">
        <%= @article.body %>
      </div>
    </div>

    <%# アクションボタン %>
    <div class="flex items-center justify-end gap-3 pt-4 border-t border-gray-800">
      <%= link_to edit_article_path(@article),
          class: "inline-flex items-center gap-1 text-sm text-gray-400 hover:text-gray-200 font-bold px-3 py-2 rounded-lg hover:bg-gray-800 transition-colors" do %>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        編集
      <% end %>
      <%= link_to typing_path(article_id: @article.id),
          class: "inline-flex items-center gap-1.5 bg-green-500 hover:bg-green-700 text-gray-950 text-sm font-bold px-4 py-2 rounded-lg transition-colors" do %>
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        練習を開始
      <% end %>
    </div>
  </div>
</div>
