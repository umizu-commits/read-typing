<div data-url-form-target="urlContent">
  <div class="mb-2">
    <h2 class="font-bold text-lg flex items-center gap-2 text-gray-100">
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
      </svg>
      URLから記事を取得
    </h2>
    <p class="text-sm text-gray-400 mt-1">
      公開されている記事のURLを貼るだけ。本文を自動で取得します。
    </p>
  </div>

  <div data-url-form-target="urlError"
       class="hidden mb-4 bg-red-950 border border-red-800 text-red-400 rounded-lg px-4 py-3 text-sm">
  </div>

  <form action="/articles" method="post" data-action="submit->url-form#submitUrl" data-turbo="false">
    <%= hidden_field_tag :authenticity_token, form_authenticity_token %>
    <label class="block text-xs font-bold text-gray-400 mb-1">
      記事URL
    </label>
    <input type="url"
           name="url"
           data-url-form-target="urlInput"
           placeholder="https://example.com/article"
           class="w-full border border-gray-700 bg-gray-800 text-gray-100 placeholder-gray-500 rounded-lg p-3 text-sm
                  focus:outline-none focus:ring-2 focus:ring-green-500">
    <div class="grid grid-cols-2 gap-3 mt-3">
      <div>
        <label class="block text-xs font-bold text-gray-400 mb-1">
          カテゴリ
          <span class="text-gray-500 font-normal ml-1">（任意）</span>
        </label>
        <select name="category"
                class="w-full border border-gray-700 bg-gray-800 text-gray-300 rounded-lg p-3 text-sm focus:outline-none focus:ring-2 focus:ring-green-500">
          <option value="">選択しない</option>
          <% Article::CATEGORIES.each do |value, label| %>
            <option value="<%= value %>"><%= label %></option>
          <% end %>
        </select>
      </div>
      <div>
        <label class="block text-xs font-bold text-gray-400 mb-1">
          タグ
          <span class="text-gray-500 font-normal ml-1">（任意・カンマ区切り）</span>
        </label>
        <input type="text"
               name="tag_names"
               placeholder="例：Rails, タイピング"
               class="w-full border border-gray-700 bg-gray-800 text-gray-100 placeholder-gray-500 rounded-lg p-3 text-sm focus:outline-none focus:ring-2 focus:ring-green-500">
      </div>
    </div>

    <button type="submit"
            class="w-full bg-green-500 hover:bg-green-700 text-gray-950 font-bold py-3
                  rounded-lg mt-3 cursor-pointer transition-colors">
      記事を取得してタイピング練習を開始する
    </button>

    <button type="button"
            data-action="click->url-form#fetchWithoutSave"
            class="w-full bg-gray-800 hover:bg-gray-700 text-gray-300 border border-gray-700 font-bold py-3 rounded-lg mt-2 cursor-pointer transition-colors">
      保存せずに開始する
    </button>
    <% if user_signed_in? %>
      <div class="text-center mt-1">
        <button type="button"
                data-action="click->url-form#saveOnlyUrl"
                class="text-xs text-gray-500 hover:text-green-500 transition-colors">
          保存のみ
        </button>
      </div>
    <% end %>
  </form>
</div>
