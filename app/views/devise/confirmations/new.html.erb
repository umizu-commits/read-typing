<div class="flex items-center justify-center flex-1">
  <div class="w-[400px] rounded-xl bg-white p-8 shadow-sm space-y-6">
    <h1 class="text-xl font-bold text-gray-800 text-center">確認メールの再送信</h1>

    <%= form_for(resource, as: resource_name, url: confirmation_path(resource_name), html: { method: :post }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div>
        <p class="text-sm font-bold text-gray-700 mb-1">メールアドレス</p>
        <%= f.email_field :email,
            autofocus: true,
            autocomplete: "email",
            value: (resource.pending_reconfirmation? ? resource.unconfirmed_email : resource.email),
            class: "w-full rounded-lg border border-gray-300 px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" %>
      </div>

      <%= f.submit "確認メールを再送信する",
          class: "w-full mt-6 rounded-lg bg-blue-400 px-6 py-3 font-bold text-white shadow-sm hover:bg-blue-500 cursor-pointer" %>
    <% end %>

    <div class="text-center text-sm text-gray-500">
      <%= link_to "ログインページに戻る", new_user_session_path, class: "text-blue-500 hover:underline" %>
    </div>
  </div>  
</div>
