<div class="flex items-center justify-center flex-1">
  <div class="w-[400px] rounded-xl bg-white p-8 shadow-sm space-y-6">
    <h1 class="text-xl font-bold text-gray-800 text-center">新しいパスワードを設定する</h1>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="space-y-4">
        <div>
          <p class="text-sm font-bold text-gray-700 mb-1">新しいパスワード</p>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
              class: "w-full rounded-lg border border-gray-300 px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" %>
        </div>

        <div>
          <p class="text-sm font-bold text-gray-700 mb-1">新しいパスワード（確認用）</p>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "w-full rounded-lg border border-gray-300 px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" %>
        </div>
      </div>

      <%= f.submit "パスワードを変更",
          class: "w-full mt-6 rounded-lg bg-blue-400 px-6 py-3 font-bold text-white shadow-sm hover:bg-blue-500 cursor-pointer" %>
    <% end %>
  </div>
</div>
