<% content_for :title, "パスワード再設定 | ReadTyping" %>

<div class="flex items-center justify-center flex-1">
  <div class="w-[400px] rounded-xl bg-gray-900 border border-gray-800 p-8 shadow-xl ring-1 ring-white/5 space-y-6">
    <h1 class="text-xl font-bold text-gray-100 text-center">新しいパスワードを設定する</h1>

    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>
      <%= f.hidden_field :reset_password_token %>

      <div class="space-y-4">
        <div>
          <p class="text-xs font-bold text-gray-400 mb-1">新しいパスワード</p>
          <%= f.password_field :password, autofocus: true, autocomplete: "new-password",
              class: "w-full rounded-lg border border-gray-700 bg-gray-800 text-gray-100 placeholder-gray-500 px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-500" %>
        </div>

        <div>
          <p class="text-xs font-bold text-gray-400 mb-1">新しいパスワード（確認用）</p>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "w-full rounded-lg border border-gray-700 bg-gray-800 text-gray-100 placeholder-gray-500 px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-500" %>
        </div>
      </div>

      <%= f.submit "パスワードを変更",
          class: "w-full mt-6 rounded-lg bg-green-500 hover:bg-green-700 px-6 py-3 font-bold text-gray-950 shadow-sm cursor-pointer" %>
    <% end %>
  </div>
</div>
