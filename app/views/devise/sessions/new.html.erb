<% content_for :title, "ログイン | ReadTyping" %>

<div class="flex items-center justify-center flex-1">
  <div class="w-[400px] rounded-xl bg-gray-900 border border-gray-800 p-8 shadow-xl ring-1 ring-white/5 space-y-6">
    <h1 class="text-xl font-bold text-gray-100 text-center">ログイン</h1>

    <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
      <div class="space-y-4">
        <div>
          <p class="text-xs font-bold text-gray-400 mb-1">メールアドレス</p>
          <%= f.email_field :email,
              autofocus: true,
              autocomplete: "email",
              class: "w-full rounded-lg border border-gray-700 bg-gray-800 text-gray-100 placeholder-gray-500 px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-500" %>
        </div>

        <div>
          <p class="text-xs font-bold text-gray-400 mb-1">パスワード</p>
          <%= f.password_field :password,
              autocomplete: "current-password",
              class: "w-full rounded-lg border border-gray-700 bg-gray-800 text-gray-100 placeholder-gray-500 px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-500" %>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <%= f.check_box :remember_me, class: "rounded text-green-600 focus:ring-green-500" %>
        <%= f.label :remember_me, "次回から自動的にログインする", class: "text-sm font-medium text-gray-300" %>
      </div>

      <%= f.submit "ログイン",
          class: "w-full mt-6 rounded-lg bg-green-500 hover:bg-green-700 px-6 py-3 font-bold text-gray-950 shadow-sm cursor-pointer" %>
    <% end %>

    <div class="relative flex items-center">
      <div class="flex-grow border-t border-gray-700"></div>
      <span class="mx-3 text-xs text-gray-500">または</span>
      <div class="flex-grow border-t border-gray-700"></div>
    </div>

    <%= button_to user_google_oauth2_omniauth_authorize_path,
        method: :post,
        form: { data: { turbo: false } },
        class: "flex items-center justify-center gap-2 w-full rounded-lg border border-gray-700 px-6 py-3 text-sm font-bold text-gray-300 hover:bg-gray-800 cursor-pointer bg-gray-900" do %>
      <svg class="w-4 h-4" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
        <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
        <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
        <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
      </svg>
      Googleでログイン
    <% end %>

    <%= button_to user_github_omniauth_authorize_path,
        method: :post,
        form: { data: { turbo: false } },
        class: "flex items-center justify-center gap-2 w-full rounded-lg border border-gray-700 px-6 py-3 text-sm font-bold text-gray-300 hover:bg-gray-800 cursor-pointer bg-gray-900" do %>
      <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.44 9.8 8.21 11.39.6.11.82-.26.82-.58 0-.29-.01-1.05-.02-2.06-3.34.73-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.09-.74.08-.73.08-.73 1.2.08 1.84 1.23 1.84 1.23 1.07 1.83 2.8 1.3 3.49.99.11-.77.42-1.3.76-1.6-2.66-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.23-3.22-.12-.3-.53-1.52.12-3.18 0 0 1.01-.32 3.3 1.23.96-.27 1.98-.4 3-.41 1.02.01 2.04.14 3 .41 2.29-1.55 3.3-1.23 3.3-1.23.65 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.81 5.62-5.49 5.92.43.37.82 1.1.82 2.22 0 1.6-.01 2.89-.01 3.29 0 .32.22.7.83.58A12.01 12.01 0 0 0 24 12c0-6.63-5.37-12-12-12z"/>
      </svg>
      GitHubでログイン
    <% end %>

    <div class="flex flex-col gap-2 items-center text-sm text-gray-400">
      <div>
        アカウントをお持ちでない方は
        <%= link_to "新規登録", new_user_registration_path, class: "text-green-500 hover:underline" %>
      </div>
      <%= link_to "パスワードを忘れた方はこちら", new_user_password_path, class: "text-green-500 hover:underline" %>
    </div>
  </div>
</div>
