<% content_for :title, "アカウント編集 | ReadTyping" %>

<div class="flex items-center justify-center flex-1 py-8">
  <div class="w-[480px] rounded-xl bg-gray-900 border border-gray-800 p-8 shadow-2xl space-y-6">
    <h1 class="text-xl font-bold text-gray-100 text-center">アカウント編集</h1>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="space-y-4">
        <div>
          <p class="text-xs font-bold text-gray-400 mb-1">メールアドレス</p>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",
              class: "w-full rounded-lg border border-gray-700 bg-gray-800 text-gray-100 placeholder-gray-500 px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-500" %>
          <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
            <p class="text-xs text-gray-400 mt-1">確認待ちメールアドレス: <%= resource.unconfirmed_email %></p>
          <% end %>
        </div>

        <div>
          <p class="text-xs font-bold text-gray-400 mb-1">
            新しいパスワード
            <span class="text-xs font-normal text-gray-500">（変更しない場合は空欄）</span>
          </p>
          <%= f.password_field :password, autocomplete: "new-password",
              class: "w-full rounded-lg border border-gray-700 bg-gray-800 text-gray-100 placeholder-gray-500 px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-500" %>
          <% if @minimum_password_length %>
            <p class="text-xs text-gray-500 mt-1"><%= @minimum_password_length %>文字以上</p>
          <% end %>
        </div>

        <div>
          <p class="text-xs font-bold text-gray-400 mb-1">新しいパスワード（確認）</p>
          <%= f.password_field :password_confirmation, autocomplete: "new-password",
              class: "w-full rounded-lg border border-gray-700 bg-gray-800 text-gray-100 placeholder-gray-500 px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-500" %>
        </div>

        <div>
          <p class="text-xs font-bold text-gray-400 mb-1">
            現在のパスワード
            <span class="text-xs font-normal text-gray-500">（変更を確定するために必要）</span>
          </p>
          <%= f.password_field :current_password, autocomplete: "current-password",
              class: "w-full rounded-lg border border-gray-700 bg-gray-800 text-gray-100 placeholder-gray-500 px-4 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-500" %>
        </div>
      </div>

      <%= f.submit "更新する",
          class: "w-full mt-6 rounded-lg bg-green-500 hover:bg-green-700 px-6 py-3 font-bold text-gray-950 shadow-sm cursor-pointer" %>
    <% end %>

    <div class="border-t border-gray-800 pt-4">
      <p class="text-sm font-bold text-red-400 mb-2">アカウントを削除する</p>
      <%= button_to "アカウントを削除",
          registration_path(resource_name),
          data: { turbo_confirm: "本当にアカウントを削除しますか？この操作は取り消せません。" },
          method: :delete,
          class: "w-full rounded-lg border border-red-800 text-red-400 hover:bg-red-950 px-4 py-2 text-sm font-bold cursor-pointer" %>
    </div>

    <div class="text-center">
      <%= link_to "戻る", :back, class: "text-sm text-gray-400 hover:text-gray-300" %>
    </div>
  </div>
</div>
