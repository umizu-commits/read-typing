<% if notice.present? %>
  <div class="mt-4 text-center">
    <div class="inline-flex items-center rounded-full bg-green-50 border border-green-200 px-4 py-2 text-sm font-bold text-green-700">
      <%= notice %>
    </div>
  </div>
<% end %>

<% if alert.present? %>
  <div class="mt-4 text-center">
    <div class="inline-flex items-center rounded-full bg-red-50 border border-red-200 px-4 py-2 text-sm font-bold text-red-700">
      <%= alert %>
    </div>
  </div>
<% end %>
