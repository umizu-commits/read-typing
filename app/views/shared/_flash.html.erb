<% if notice.present? %>
  <div class="mt-4 text-center">
    <div class="inline-flex items-center rounded-full bg-gray-900 border border-green-700 px-4 py-2 text-sm font-bold text-green-500">
      <%= notice %>
    </div>
  </div>
<% end %>

<% if alert.present? %>
  <div class="mt-4 text-center">
    <div class="inline-flex items-center rounded-full bg-gray-900 border border-red-700 px-4 py-2 text-sm font-bold text-red-400">
      <%= alert %>
    </div>
  </div>
<% end %>
