<!-- ログイン系のフラッシュメッセージ -->
<% if notice.present? %>
  <div data-controller="flash"
       class="mt-4 rounded-lg bg-green-100 px-4 py-3 text-sm text-green-700 flex items-start justify-between gap-3">
    <p><%= notice %></p>
    <button type="button"
            data-action="click->flash#dismiss"
            aria-label="閉じる"
            class="shrink-0 text-green-700 hover:text-green-900 leading-none">
      ✕
    </button>
  </div>
<% end %>

<% if alert.present? %>
  <div data-controller="flash"
       class="mt-4 rounded-lg bg-red-100 px-4 py-3 text-sm text-red-700 flex items-start justify-between gap-3">
    <p><%= alert %></p>
    <button type="button"
            data-action="click->flash#dismiss"
            aria-label="閉じる"
            class="shrink-0 text-red-700 hover:text-red-900 leading-none">
      ✕
    </button>
  </div>
<% end %>
