<%# 新着バッジ通知 %>
<% if @new_achievements.any? %>
  <div class="bg-gray-900 border border-green-800 rounded-xl p-5 mb-4">
    <div class="flex items-center gap-3 mb-4">
      <div class="relative flex items-center justify-center shrink-0">
        <div class="absolute w-9 h-9 rounded-full bg-green-500 opacity-20 blur-md"></div>
        <div class="absolute w-9 h-9 rounded-full border border-green-500/40 scale-[1.2]"></div>
        <div class="relative w-9 h-9 rounded-full bg-gray-800 border-2 border-green-500 flex items-center justify-center">
          <svg class="w-4 h-4 text-green-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11.48 3.499a.562.562 0 011.04 0l2.125 5.111a.563.563 0 00.475.345l5.518.442c.499.04.701.663.321.988l-4.204 3.602a.563.563 0 00-.182.557l1.285 5.385a.562.562 0 01-.84.61l-4.725-2.885a.563.563 0 00-.586 0L6.982 20.54a.562.562 0 01-.84-.61l1.285-5.386a.562.562 0 00-.182-.557l-4.204-3.602a.562.562 0 01.321-.988l5.518-.442a.563.563 0 00.475-.345L11.48 3.5z" />
          </svg>
        </div>
      </div>
      <p class="text-sm font-bold text-green-400">新しい実績を獲得しました！</p>
    </div>
    <div class="flex flex-wrap gap-3">
      <% @new_achievements.each do |ua| %>
        <% definition = Achievement.find(ua.achievement_key) %>
        <% next unless definition %>
        <div class="flex items-center gap-2 bg-gray-800 border border-green-700 rounded-lg px-3 py-2">
          <div class="w-7 h-7 rounded-full bg-gray-700 border border-green-500 flex items-center justify-center shrink-0">
            <%= achievement_icon_svg(definition[:icon], css_class: "w-3.5 h-3.5", stroke_width: "1.5", color_class: "text-green-400") %>
          </div>
          <span class="text-sm font-bold text-gray-100"><%= definition[:name] %></span>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<%# 実績グリッド %>
<div class="bg-gray-900 rounded-xl border border-gray-800 shadow-xl ring-1 ring-white/5 p-5 mb-6">
  <h2 class="text-base font-bold text-gray-100 mb-4">実績</h2>
  <div class="grid grid-cols-4 gap-3">
    <% Achievement::DEFINITIONS.each do |key, definition| %>
      <% unlocked = @granted_achievement_keys.include?(key) %>
      <div class="rounded-xl border <%= unlocked ? "border-green-800 bg-gray-800" : "border-gray-800 bg-gray-900" %> p-3 flex flex-col items-center text-center gap-2">

        <%# バッジアイコン %>
        <div class="relative">
          <% if unlocked %>
            <div class="absolute inset-0 rounded-full bg-green-500 opacity-20 blur-md scale-125"></div>
            <div class="absolute inset-0 rounded-full border border-green-500/40 scale-110"></div>
          <% end %>
          <div class="relative w-12 h-12 rounded-full flex items-center justify-center
                      <%= unlocked ? "bg-gray-700 border-2 border-green-500" : "bg-gray-800 border border-gray-700" %>">
            <% if unlocked %>
              <%= achievement_icon_svg(definition[:icon], css_class: "w-6 h-6", stroke_width: "1.5", color_class: "text-green-400") %>
            <% else %>
              <%= achievement_icon_svg(:lock, css_class: "w-5 h-5", stroke_width: "1.5", color_class: "text-gray-600") %>
            <% end %>
          </div>
        </div>

        <%# バッジ名・説明 %>
        <div>
          <p class="text-xs font-bold <%= unlocked ? "text-gray-100" : "text-gray-600" %>"><%= definition[:name] %></p>
          <p class="text-[10px] mt-0.5 <%= unlocked ? "text-gray-400" : "text-gray-700" %>"><%= definition[:description] %></p>
        </div>

      </div>
    <% end %>
  </div>
</div>
