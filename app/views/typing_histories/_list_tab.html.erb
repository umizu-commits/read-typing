<%# 履歴テーブル（Turbo Frame でページネーション時にスクロール位置維持） %>
<turbo-frame id="history-table" data-turbo-action="advance" class="block">
  <div class="bg-gray-900 rounded-xl border border-gray-800 shadow-sm overflow-hidden">
    <% if @typing_results.empty? %>
      <div class="p-10 text-center">
        <svg class="w-16 h-16 mx-auto text-gray-600 mb-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z" />
        </svg>
        <p class="text-sm font-bold text-gray-200 mb-1">まだ履歴がありません</p>
        <p class="text-xs text-gray-400 mb-5">タイピング練習を完了すると、ここに結果が表示されます。</p>
        <%= link_to root_path,
            data: { turbo_frame: "_top" },
            class: "inline-flex items-center gap-2 rounded-lg bg-green-500 hover:bg-green-700 px-6 py-2.5 text-sm font-bold text-gray-950 shadow-sm" do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          練習を開始する
        <% end %>
      </div>
    <% else %>
      <table class="w-full text-sm">
        <thead>
          <tr class="border-b border-gray-800">
            <th class="text-left px-5 py-3 text-xs font-bold text-gray-400">タイトル</th>
            <th class="text-right px-5 py-3 text-xs font-bold text-gray-400 whitespace-nowrap">正答率</th>
            <th class="text-right px-5 py-3 text-xs font-bold text-gray-400 whitespace-nowrap">CPM</th>
            <th class="text-right px-5 py-3 text-xs font-bold text-gray-400 whitespace-nowrap">ミス数</th>
            <th class="text-right px-5 py-3 text-xs font-bold text-gray-400 whitespace-nowrap">タイム</th>
            <th class="text-right px-5 py-3 text-xs font-bold text-gray-400 whitespace-nowrap">実施日時</th>
          </tr>
        </thead>
        <tbody>
          <% @typing_results.each do |result| %>
            <tr class="group border-b border-gray-800 last:border-0 hover:bg-gray-800 cursor-pointer"
                data-controller="row-link"
                data-row-link-url-value="<%= typing_history_path(result) %>"
                data-action="click->row-link#visit">
              <td class="px-5 py-2 max-w-0 w-full">
                <% display_title = if result.article_title.present?
                                     result.article_title
                                   elsif result.article&.title.present?
                                     result.article.title
                                   else
                                     "#{result.created_at.strftime('%Y-%m-%d %H:%M')} の練習"
                                   end %>
                <div class="truncate text-gray-300 group-hover:text-green-500 transition-colors" title="<%= display_title %>">
                  <%= display_title %>
                </div>
              </td>
              <td class="px-5 py-1 text-right whitespace-nowrap">
                <span class="bg-gray-700 text-gray-300 px-2 py-1 rounded-full text-xs font-bold">
                  <%= result.accuracy %>%
                </span>
              </td>
              <td class="px-5 py-1 text-right font-bold text-green-500 whitespace-nowrap">
                <%= result.cpm %>
              </td>
              <td class="px-5 py-1 text-right font-bold <%= result.miss_count > 5 ? 'text-red-400' : 'text-gray-300' %>">
                <%= result.miss_count %>
              </td>
              <td class="px-5 py-1 text-right text-gray-400 whitespace-nowrap">
                <%= "%02d:%02d" % [result.elapsed_time / 60, result.elapsed_time % 60] %>
              </td>
              <td class="px-5 py-2 text-right text-gray-400 whitespace-nowrap">
                <%= result.created_at.strftime("%Y-%m-%d %H:%M") %>
              </td>
            </tr>
          <% end %>
          <%# 10件未満のページで高さを維持するための空行 %>
          <% (10 - @typing_results.size).times do %>
            <tr class="border-b border-gray-800 last:border-0">
              <td class="px-5 py-2" colspan="6">&nbsp;</td>
            </tr>
          <% end %>
        </tbody>
      </table>

      <div class="px-5 py-3 border-t border-gray-800 text-xs text-gray-500 text-center">
        全 <%= @typing_results.total_count %> セッション中 <%= @typing_results.offset_value + 1 %>-<%= [@typing_results.offset_value + 10, @typing_results.total_count].min %> を表示中
      </div>
      <% if @typing_results.total_pages > 1 %>
        <div class="px-5 py-3 border-t border-gray-800">
          <%= paginate @typing_results, window: 2, outer_window: 1, params: { tab: "list" } %>
        </div>
      <% end %>
    <% end %>
  </div>
</turbo-frame>
