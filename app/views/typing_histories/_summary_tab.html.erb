<%# サマリーカード（全件を対象に集計） %>
<% if @typing_history_summary.any_results? %>

  <%# メインカード: CPM + 正答率（主役） %>
  <div class="grid grid-cols-2 gap-4 mb-4">

    <%# CPM（メイン・最新値+前回比） %>
    <div class="bg-gray-900 rounded-xl border border-gray-800 p-4 shadow-xl ring-1 ring-white/5">
      <div class="flex items-center gap-2 mb-3">
        <div class="w-8 h-8 rounded-full bg-gray-800 flex items-center justify-center">
          <svg class="w-4 h-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div class="text-xs font-bold text-gray-400">CPM</div>
      </div>
      <div class="text-4xl font-bold text-gray-100 text-center"><%= @typing_history_summary.latest_result.cpm %></div>
      <div class="text-center mt-2">
        <% if @typing_history_summary.cpm_difference %>
          <% if @typing_history_summary.cpm_difference > 0 %>
            <span class="text-xs font-bold text-green-500">前回比 +<%= @typing_history_summary.cpm_difference %></span>
          <% elsif @typing_history_summary.cpm_difference < 0 %>
            <span class="text-xs font-bold text-red-400">前回比 <%= @typing_history_summary.cpm_difference %></span>
          <% else %>
            <span class="text-xs font-bold text-gray-400">前回比 ±0</span>
          <% end %>
        <% else %>
          <span class="text-xs text-gray-500">前回データなし</span>
        <% end %>
      </div>
      <div class="text-center text-xs text-gray-500 mt-2">
        WPM目安: <%= @typing_history_summary.latest_result.wpm %>
      </div>
    </div>

    <%# 正答率（メイン・最新値+前回比） %>
    <div class="bg-gray-900 rounded-xl border border-gray-800 p-4 shadow-xl ring-1 ring-white/5">
      <div class="flex items-center gap-2 mb-3">
        <div class="w-8 h-8 rounded-full bg-gray-800 flex items-center justify-center">
          <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="text-xs font-bold text-gray-400">正答率</div>
      </div>
      <div class="text-4xl font-bold text-gray-100 text-center"><%= @typing_history_summary.latest_result.accuracy %>%</div>
      <div class="text-center mt-2">
        <% if @typing_history_summary.accuracy_difference %>
          <% if @typing_history_summary.accuracy_difference > 0 %>
            <span class="text-xs font-bold text-green-500">前回比 +<%= @typing_history_summary.accuracy_difference %>%</span>
          <% elsif @typing_history_summary.accuracy_difference < 0 %>
            <span class="text-xs font-bold text-red-400">前回比 <%= @typing_history_summary.accuracy_difference %>%</span>
          <% else %>
            <span class="text-xs font-bold text-gray-400">前回比 ±0%</span>
          <% end %>
        <% else %>
          <span class="text-xs text-gray-500">前回データなし</span>
        <% end %>
      </div>
      <div class="text-center text-xs mt-2 invisible">高さ調整</div>
    </div>

  </div>

  <%# 補助カード: 4小カード %>
  <div class="grid grid-cols-4 gap-4 mb-3">

    <%# 累積文字数 %>
    <div class="bg-gray-900 rounded-xl border border-gray-800 p-3 shadow-xl ring-1 ring-white/5">
      <div class="flex items-center gap-2 mb-2">
        <div class="w-7 h-7 rounded-full bg-gray-800 flex items-center justify-center">
          <svg class="w-3.5 h-3.5 text-yellow-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
        </div>
        <div class="text-xs font-bold text-gray-400">累積文字数</div>
      </div>
      <div class="text-2xl font-bold text-gray-100 text-center">
        <% if @typing_history_summary.total_correct_count >= 10000 %>
          <%= (@typing_history_summary.total_correct_count / 10000.0).round(1) %>万字
        <% else %>
          <%= @typing_history_summary.total_correct_count %>字
        <% end %>
      </div>
    </div>

    <%# 総練習時間 %>
    <div class="bg-gray-900 rounded-xl border border-gray-800 p-3 shadow-xl ring-1 ring-white/5">
      <div class="flex items-center gap-2 mb-2">
        <div class="w-7 h-7 rounded-full bg-gray-800 flex items-center justify-center">
          <svg class="w-3.5 h-3.5 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="text-xs font-bold text-gray-400">総練習時間</div>
      </div>
      <% hours = @typing_history_summary.total_elapsed_time / 3600 %>
      <% minutes = (@typing_history_summary.total_elapsed_time % 3600) / 60 %>
      <div class="text-2xl font-bold text-gray-100 text-center">
        <% if hours > 0 %>
          <%= hours %>h <%= minutes %>m
        <% else %>
          <%= minutes %>m
        <% end %>
      </div>
    </div>

    <%# 完了セッション %>
    <div class="bg-gray-900 rounded-xl border border-gray-800 p-3 shadow-xl ring-1 ring-white/5">
      <div class="flex items-center gap-2 mb-2">
        <div class="w-7 h-7 rounded-full bg-gray-800 flex items-center justify-center">
          <svg class="w-3.5 h-3.5 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
          </svg>
        </div>
        <div class="text-xs font-bold text-gray-400">完了セッション</div>
      </div>
      <div class="text-2xl font-bold text-gray-100 text-center"><%= @typing_history_summary.total_sessions %> 回</div>
    </div>

    <%# 平均ミス回数 %>
    <div class="bg-gray-900 rounded-xl border border-gray-800 p-3 shadow-xl ring-1 ring-white/5">
      <div class="flex items-center gap-2 mb-2">
        <div class="w-7 h-7 rounded-full bg-gray-800 flex items-center justify-center">
          <svg class="w-3.5 h-3.5 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <div class="text-xs font-bold text-gray-400">平均ミス回数</div>
      </div>
      <div class="text-2xl font-bold text-gray-100 text-center"><%= @typing_history_summary.average_miss_count %></div>
    </div>

  </div>
<% end %>

<%# CPM推移グラフ %>
<% if @typing_history_summary.any_results? %>
  <div class="bg-gray-900 rounded-xl border border-gray-800 shadow-xl ring-1 ring-white/5 p-4 mb-6">
    <div class="flex items-start justify-between gap-3 mb-3">
      <div>
        <h2 class="text-base font-bold text-gray-100">CPM・正答率 推移</h2>
        <p class="text-xs text-gray-400 mt-1">ハロ付きのダイヤモンドは自己ベスト。ポイントにカーソルを合わせると詳細を表示します。</p>
      </div>
      <%# 期間フィルタ %>
      <div class="flex gap-1 shrink-0">
        <% { "7d" => "直近7日", "30d" => "直近30日", "all" => "全期間" }.each do |key, label| %>
          <%= link_to label, typing_histories_path(tab: :summary, period: key),
              class: "px-3 py-1.5 rounded-lg text-xs font-bold transition-colors #{key == @typing_history_summary.current_period ? 'bg-green-700 text-gray-950' : 'border border-gray-700 text-gray-400 hover:bg-gray-800'}" %>
        <% end %>
      </div>
    </div>
    <% if @typing_history_summary.chart_data.empty? %>
      <div class="h-[280px] flex items-center justify-center text-sm text-gray-500">
        この期間の練習記録がありません
      </div>
    <% else %>
      <div style="height:280px; position:relative;">
        <canvas data-controller="chart"
                data-chart-data-value="<%= @typing_history_summary.chart_data.to_json %>"></canvas>
      </div>
    <% end %>
  </div>

  <%# 継続ヒートマップ %>
  <div class="bg-gray-900 rounded-xl border border-gray-800 shadow-xl ring-1 ring-white/5 p-4 mb-6">
    <div class="flex items-start justify-between mb-4">
      <div>
        <h2 class="text-base font-bold text-gray-100">練習継続マップ</h2>
        <p class="text-xs text-gray-400 mt-1"><%= @typing_history_summary.year %>年の練習回数。色が濃いほど多く練習した日です。</p>
      </div>
      <span class="inline-flex items-center rounded-full bg-gray-800 text-gray-300 px-3 py-1 text-xs font-bold shrink-0">
        <%= @typing_history_summary.year %>年
      </span>
    </div>

    <div class="flex items-start gap-2">
      <%# 曜日ラベル（一行おきに表示） %>
      <div class="flex flex-col gap-1 text-[10px] text-gray-500 shrink-0">
        <% %w[日 月 火 水 木 金 土].each_with_index do |label, i| %>
          <div class="h-4 leading-4"><%= i.odd? ? label : "" %></div>
        <% end %>
      </div>

      <%# ヒートマップ本体 %>
      <div class="grid grid-flow-col gap-1" style="grid-template-rows: repeat(7, 1rem); grid-auto-columns: 1rem;">
        <% @typing_history_summary.heatmap_days.each do |day| %>
          <% if day[:in_range] %>
            <% bg = case day[:count]
                    when 0 then "bg-gray-800"
                    when 1 then "bg-green-900"
                    when 2..3 then "bg-green-700"
                    when 4..7 then "bg-green-500"
                    else "bg-green-400"
                    end %>
            <% jp_wday = %w[日 月 火 水 木 金 土][day[:date].wday] %>
            <div class="<%= bg %> rounded-sm w-4 h-4"
                 title="<%= day[:date].strftime('%Y/%m/%d') %> (<%= jp_wday %>) · <%= day[:count] %>回練習"></div>
          <% elsif day[:in_year] %>
            <%# 今年の未来日（プレースホルダ） %>
            <div class="bg-gray-800/40 rounded-sm w-4 h-4"></div>
          <% else %>
            <%# 範囲外（前年末・翌年頭のパディング） %>
            <div class="w-4 h-4"></div>
          <% end %>
        <% end %>
      </div>
    </div>

    <%# 凡例 + サマリー %>
    <div class="flex items-center justify-between mt-4">
      <div class="text-xs text-gray-400">
        今年は <span class="font-bold text-green-400"><%= @typing_history_summary.heatmap_active_days %></span> 日練習・計 <span class="font-bold text-green-400"><%= @typing_history_summary.heatmap_total_count %></span> 回
      </div>
      <div class="flex items-center gap-2 text-[10px] text-gray-500">
        <span>少</span>
        <div class="flex gap-1">
          <div class="w-4 h-4 rounded-sm bg-gray-800"></div>
          <div class="w-4 h-4 rounded-sm bg-green-900"></div>
          <div class="w-4 h-4 rounded-sm bg-green-700"></div>
          <div class="w-4 h-4 rounded-sm bg-green-500"></div>
          <div class="w-4 h-4 rounded-sm bg-green-400"></div>
        </div>
        <span>多</span>
      </div>
    </div>
  </div>
<% end %>

<%= render "typing_histories/achievements_section" %>
