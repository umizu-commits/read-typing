<% content_for :title, "タイピング履歴 詳細 | ReadTyping" %>

<div class="w-full py-4 max-w-4xl mx-auto">

  <%# タイトルと戻るリンク %>
  <div class="mb-4 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-100">タイピング履歴 詳細</h1>
      <p class="text-sm text-gray-400 mt-1"><%= @typing_result.created_at.strftime("%Y年%m月%d日 %H:%M") %>の記録</p>
    </div>
    <%= link_to typing_histories_path(tab: :list),
        class: "inline-flex items-center gap-1 rounded-lg border border-gray-700 bg-gray-900 hover:bg-gray-800 px-4 py-2 text-sm font-bold text-gray-300 shadow-sm" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      履歴一覧に戻る
    <% end %>
  </div>

  <%# スコアカード（4カード横並び） %>
  <div class="grid grid-cols-4 gap-3 mb-6">

    <%# 正答率 %>
    <div class="rounded-xl border border-gray-800 bg-gray-900 p-5 shadow-sm">
      <div class="flex items-center gap-2 mb-3">
        <div class="w-8 h-8 rounded-full bg-gray-800 flex items-center justify-center">
          <svg class="w-4 h-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="text-xs font-bold text-gray-400">正答率</div>
      </div>
      <div class="text-3xl font-bold text-gray-100 text-center"><%= @typing_result.accuracy %>%</div>
    </div>

    <%# CPM（WPM補助表記内蔵） %>
    <div class="rounded-xl border border-gray-800 bg-gray-900 p-5 shadow-sm">
      <div class="flex items-center gap-2 mb-3">
        <div class="w-8 h-8 rounded-full bg-gray-800 flex items-center justify-center">
          <svg class="w-4 h-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div class="text-xs font-bold text-gray-400">CPM</div>
      </div>
      <div class="text-3xl font-bold text-gray-100 text-center"><%= @typing_result.cpm %></div>
      <div class="text-center text-xs text-gray-500 mt-2">
        WPM目安: <%= @typing_result.wpm %>
      </div>
    </div>

    <%# ミス数 %>
    <div class="rounded-xl border border-gray-800 bg-gray-900 p-5 shadow-sm">
      <div class="flex items-center gap-2 mb-3">
        <div class="w-8 h-8 rounded-full bg-gray-800 flex items-center justify-center">
          <svg class="w-4 h-4 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <div class="text-xs font-bold text-gray-400">ミス数</div>
      </div>
      <div class="text-3xl font-bold text-center <%= @typing_result.miss_count > 5 ? 'text-red-400' : 'text-gray-100' %>">
        <%= @typing_result.miss_count %>
      </div>
    </div>

    <%# タイム %>
    <div class="rounded-xl border border-gray-800 bg-gray-900 p-5 shadow-sm">
      <div class="flex items-center gap-2 mb-3">
        <div class="w-8 h-8 rounded-full bg-gray-800 flex items-center justify-center">
          <svg class="w-4 h-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="text-xs font-bold text-gray-400">タイム</div>
      </div>
      <div class="text-3xl font-bold text-gray-100 text-center">
        <%= "%02d:%02d" % [@typing_result.elapsed_time / 60, @typing_result.elapsed_time % 60] %>
      </div>
    </div>

  </div>

  <%# 記事情報 %>
  <% display_title = if @typing_result.article_title.present?
                       @typing_result.article_title
                     elsif @typing_result.article&.title.present?
                       @typing_result.article.title
                     else
                       "#{@typing_result.created_at.strftime('%Y-%m-%d %H:%M')} の練習"
                     end %>

  <div class="bg-gray-900 border border-gray-800 border-l-4 border-l-green-600 rounded-r-lg shadow-sm">

    <%# タイトル %>
    <div class="px-5 py-4">
      <p class="text-xs font-bold text-gray-400 mb-1">練習した記事</p>
      <p class="text-base font-bold text-gray-100">
        <%= display_title %>
      </p>
    </div>

    <%# URL・操作（記事が紐づいている場合のみ表示） %>
    <% if @typing_result.article.present? %>
      <% if @typing_result.article.url.present? %>
        <div class="border-t border-gray-800 px-5 py-4">
          <p class="text-xs font-bold text-gray-400 mb-1">URL</p>
          <%= link_to @typing_result.article.url, @typing_result.article.url,
              target: "_blank", rel: "noopener noreferrer",
              class: "text-green-500 hover:underline text-sm break-all" %>
        </div>
      <% end %>

      <%# タイトル編集フォーム %>
      <div class="border-t border-gray-800 px-5 py-4">
        <p class="text-xs font-bold text-gray-400 mb-2">記事タイトルを編集する</p>
        <%= form_with url: typing_history_path(@typing_result), method: :patch do |f| %>
          <div class="flex gap-2">
            <%= f.text_field :title, value: @typing_result.article.title,
                placeholder: "記事タイトルを入力（空にして更新すると削除されます）",
                class: "flex-1 border border-gray-700 bg-gray-800 text-gray-100 placeholder-gray-500 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-green-500" %>
            <%= f.submit "更新する",
                class: "rounded-lg bg-green-500 hover:bg-green-700 px-4 py-2 text-sm font-bold text-gray-950 cursor-pointer" %>
          </div>
        <% end %>
      </div>

      <%# アクションボタン %>
      <div class="border-t border-gray-800 px-5 py-4 flex items-center gap-3">
        <%= link_to article_path(@typing_result.article),
            class: "inline-flex items-center gap-1.5 text-sm font-bold text-gray-400 hover:text-gray-200 px-3 py-2 rounded-lg hover:bg-gray-800 transition-colors" do %>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
          </svg>
          保存記事を見る
        <% end %>
        <%= link_to typing_path(article_id: @typing_result.article.id),
            class: "inline-flex items-center gap-1.5 bg-green-500 hover:bg-green-700 text-gray-950 text-sm font-bold px-4 py-2 rounded-lg transition-colors" do %>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
          </svg>
          再練習する
        <% end %>
      </div>
    <% end %>
  </div>
</div>
