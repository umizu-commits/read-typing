<% content_for :title, "タイピング履歴 詳細 | ReadTyping" %>

<div class="w-full py-4 max-w-4xl mx-auto">

  <%# タイトルと戻るリンク %>
  <div class="mb-4 flex items-center justify-between">
    <div>
      <h1 class="text-2xl font-bold text-gray-800">タイピング履歴 詳細</h1>
      <p class="text-sm text-gray-500 mt-1"><%= @typing_result.created_at.strftime("%Y年%m月%d日 %H:%M") %>の記録</p>
    </div>
    <%= link_to typing_histories_path(tab: :list),
        class: "inline-flex items-center gap-1 rounded-lg border border-gray-300 bg-white hover:bg-gray-50 px-4 py-2 text-sm font-bold text-gray-700 shadow-sm" do %>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
      履歴一覧に戻る
    <% end %>
  </div>

  <%# スコアカード（4カード横並び、Result画面と統一） %>
  <div class="grid grid-cols-4 gap-3 mb-6">

    <%# 正答率 %>
    <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
      <div class="flex items-center gap-2 mb-3">
        <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center">
          <svg class="w-4 h-4 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="text-xs font-bold text-gray-500">正答率</div>
      </div>
      <div class="text-3xl font-bold text-gray-900 text-center"><%= @typing_result.accuracy %>%</div>
    </div>

    <%# CPM（WPM補助表記内蔵） %>
    <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
      <div class="flex items-center gap-2 mb-3">
        <div class="w-8 h-8 rounded-full bg-green-100 flex items-center justify-center">
          <svg class="w-4 h-4 text-green-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
        </div>
        <div class="text-xs font-bold text-gray-500">CPM</div>
      </div>
      <div class="text-3xl font-bold text-gray-900 text-center"><%= @typing_result.cpm %></div>
      <div class="text-center text-xs text-gray-400 mt-2">
        WPM目安: <%= @typing_result.wpm %>
      </div>
    </div>

    <%# ミス数 %>
    <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
      <div class="flex items-center gap-2 mb-3">
        <div class="w-8 h-8 rounded-full bg-red-100 flex items-center justify-center">
          <svg class="w-4 h-4 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <div class="text-xs font-bold text-gray-500">ミス数</div>
      </div>
      <div class="text-3xl font-bold text-center <%= @typing_result.miss_count > 5 ? 'text-red-500' : 'text-gray-900' %>">
        <%= @typing_result.miss_count %>
      </div>
    </div>

    <%# タイム %>
    <div class="rounded-xl border border-gray-200 bg-white p-5 shadow-sm">
      <div class="flex items-center gap-2 mb-3">
        <div class="w-8 h-8 rounded-full bg-blue-100 flex items-center justify-center">
          <svg class="w-4 h-4 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="text-xs font-bold text-gray-500">タイム</div>
      </div>
      <div class="text-3xl font-bold text-gray-900 text-center">
        <%= "%02d:%02d" % [@typing_result.elapsed_time / 60, @typing_result.elapsed_time % 60] %>
      </div>
    </div>

  </div>

  <%# 記事情報（Result画面と統一: 左ボーダー青アクセント） %>
  <% display_title = if @typing_result.article_title.present?
                       @typing_result.article_title
                     elsif @typing_result.article&.title.present?
                       @typing_result.article.title
                     else
                       "#{@typing_result.created_at.strftime('%Y-%m-%d %H:%M')} の練習"
                     end %>

  <div class="bg-white border border-gray-200 border-l-4 border-l-blue-500 rounded-r-lg shadow-sm">

    <%# タイトル %>
    <div class="px-5 py-4">
      <p class="text-xs font-bold text-gray-500 mb-1">練習した記事</p>
      <p class="text-base font-bold text-gray-800">
        <%= display_title %>
      </p>
    </div>

    <%# URL（URLモードの場合のみ表示） %>
    <% if @typing_result.article.present? %>
      <div class="border-t border-gray-100 px-5 py-4">
        <p class="text-xs font-bold text-gray-500 mb-1">URL</p>
        <%= link_to @typing_result.article.url, @typing_result.article.url,
            target: "_blank", rel: "noopener noreferrer",
            class: "text-blue-500 hover:underline text-sm break-all" %>
      </div>

      <%# タイトル編集フォーム %>
      <div class="border-t border-gray-100 px-5 py-4">
        <p class="text-xs font-bold text-gray-500 mb-2">記事タイトルを編集する</p>
        <%= form_with url: typing_history_path(@typing_result), method: :patch do |f| %>
          <div class="flex gap-2">
            <%= f.text_field :title, value: @typing_result.article.title,
                placeholder: "記事タイトルを入力（空にして更新すると削除されます）",
                class: "flex-1 border border-gray-300 rounded-lg px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-blue-300" %>
            <%= f.submit "更新する",
                class: "rounded-lg bg-blue-500 hover:bg-blue-600 px-4 py-2 text-sm font-bold text-white cursor-pointer" %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
</div>
