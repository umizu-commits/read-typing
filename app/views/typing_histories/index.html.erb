<% content_for :title, "タイピング履歴 | ReadTyping" %>

<div class="w-full py-4 max-w-6xl mx-auto">

  <%# タイトル %>
  <div class="mb-4">
    <h1 class="text-2xl font-bold text-gray-800">タイピング履歴</h1>
    <p class="text-sm text-gray-500 mt-1">これまでの学習成果を確認して、スキルの向上を目指しましょう。</p>
  </div>

  <% if @all_typing_results.empty? %>
    <%# 0件時は空状態を直接表示（タブは出さない） %>
    <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
      <div class="p-10 text-center">
        <p class="text-sm font-bold text-gray-700 mb-1">まだ履歴がありません</p>
        <p class="text-xs text-gray-500 mb-5">タイピング練習を完了すると、ここに結果が表示されます。</p>
        <%= link_to root_path,
            data: { turbo_frame: "_top" },
            class: "inline-flex items-center gap-2 rounded-lg bg-blue-500 hover:bg-blue-600 px-6 py-2.5 text-sm font-bold text-white shadow-sm" do %>
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          練習を開始する
        <% end %>
      </div>
    </div>
  <% else %>
    <%# タブUI（1件以上ある時のみ表示） %>
    <div class="border-b border-gray-200 mb-6">
      <nav class="flex gap-1" aria-label="タブ">
        <%= link_to typing_histories_path(tab: :summary),
            class: "px-5 py-2.5 text-sm font-bold border-b-2 #{@active_tab == 'summary' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-blue-500'}" do %>
          成長サマリー
        <% end %>
        <%= link_to typing_histories_path(tab: :list),
            class: "px-5 py-2.5 text-sm font-bold border-b-2 #{@active_tab == 'list' ? 'border-blue-500 text-blue-600' : 'border-transparent text-gray-500 hover:text-blue-500'}" do %>
          履歴一覧
        <% end %>
      </nav>
    </div>

    <%# タブ別コンテンツ %>
    <% if @active_tab == "summary" %>
      <%= render "summary_tab" %>
    <% else %>
      <%= render "list_tab" %>
    <% end %>
  <% end %>

</div>
