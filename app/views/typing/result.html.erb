<% content_for :title, "タイピング結果 | ReadTyping" %>
<% content_for :og_title, "タイピング結果 | ReadTyping" %>
<% content_for :og_description, "ReadTypingでタイピング練習を完了しました！あなたも興味のある記事でタイピング練習をしてみませんか？" %>
<% content_for :twitter_title, "タイピング結果 | ReadTyping" %>

<div data-controller="result"
     data-result-app-url-value="<%= root_url %>"
     class="py-10 px-4">

  <%# 外枠カード %>
  <div class="max-w-4xl mx-auto bg-gray-900 rounded-xl border border-gray-800 shadow-xl ring-1 ring-white/5 p-8">

    <%# 通常完了メッセージ（デフォルト表示） %>
    <div data-result-target="completedMessage" class="text-center mb-8">
      <%# ランクバッジ %>
      <div class="relative flex justify-center mb-6">
        <%# グロー %>
        <div class="absolute w-24 h-24 rounded-full bg-green-500 opacity-20 blur-2xl"></div>
        <%# 外リング x2 %>
        <div class="absolute w-24 h-24 rounded-full border border-green-500/20 scale-[1.35]"></div>
        <div class="absolute w-24 h-24 rounded-full border border-green-500/40 scale-[1.18]"></div>
        <%# メインバッジ %>
        <div class="relative w-24 h-24 rounded-full bg-gray-800 border-2 border-green-500 flex items-center justify-center">
          <span data-result-target="rankLetter" class="text-5xl font-black text-green-400 leading-none opacity-0 scale-50">--</span>
        </div>
      </div>
      <h1 class="text-3xl font-bold text-gray-100 mb-2">練習完了！お疲れ様でした。</h1>
      <p class="text-sm text-gray-400">タイピングを最後まで完了しました。</p>
    </div>

    <%# 途中終了メッセージ（hidden） %>
    <div data-result-target="endedMessage" class="hidden text-center mb-8">
      <h1 class="text-3xl font-bold text-gray-100 mb-2">お疲れ様でした。</h1>
      <p class="text-sm text-gray-400">タイピングを途中で終了しました。</p>
    </div>

    <%# 実績取得通知（JSで動的に追加） %>
    <div data-result-target="achievementBanners" class="space-y-2 mb-4"></div>

    <%# 保存成功 %>
    <div data-result-target="saveSuccess" class="hidden text-center mb-6">
      <div class="inline-flex items-center gap-2 rounded-full bg-gray-800 border border-green-800 px-4 py-2 text-sm font-bold text-green-500">
        <svg class="w-4 h-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
        結果を保存しました
      </div>
    </div>

    <%# 保存失敗 %>
    <div data-result-target="saveFailed" class="hidden text-center mb-6">
      <div class="inline-flex items-center gap-2 rounded-full bg-gray-800 border border-red-800 px-4 py-2 text-sm font-bold text-red-400">
        <svg class="w-4 h-4 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
        結果の保存に失敗しました
      </div>
    </div>

    <%# コピー完了 %>
    <div data-result-target="copySuccess" class="hidden text-center mb-6">
      <div class="inline-flex items-center gap-2 rounded-full bg-gray-800 border border-green-800 px-4 py-2 text-sm font-bold text-green-500">
        <svg class="w-4 h-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
        クリップボードにコピーしました
      </div>
    </div>

    <%# 結果スタッツ（4カード grid 等分） %>
    <div class="grid grid-cols-4 gap-3 mb-6">

      <%# 正答率 %>
      <div class="rounded-xl border border-gray-800 bg-gray-900 p-5">
        <div class="flex items-center gap-2 mb-3">
          <div class="w-8 h-8 rounded-full bg-gray-800 flex items-center justify-center">
            <svg class="w-4 h-4 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="text-xs font-bold text-gray-400">正答率</div>
        </div>
        <div data-result-target="accuracy" class="text-4xl font-bold text-gray-100 text-center">--%</div>
      </div>

      <%# CPM（WPM補助表記内蔵） %>
      <div class="rounded-xl border border-gray-800 bg-gray-900 p-5">
        <div class="flex items-center gap-2 mb-3">
          <div class="w-8 h-8 rounded-full bg-gray-800 flex items-center justify-center">
            <svg class="w-4 h-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>
          <div class="relative group flex items-center gap-1 cursor-help">
            <div class="text-xs font-bold text-gray-400">CPM</div>
            <span class="w-3 h-3 rounded-full border border-gray-600 flex items-center justify-center text-[8px] font-bold text-gray-500">?</span>
            <div class="absolute bottom-full left-0 mb-2 w-[240px] rounded-lg bg-gray-800 text-white text-xs p-3 hidden group-hover:block z-20 shadow-lg pointer-events-none">
              <span class="font-bold text-green-500">CPM</span>（Characters Per Minute）: 1分間に入力できた文字数です。
            </div>
          </div>
        </div>
        <div data-result-target="cpm" class="text-4xl font-bold text-gray-100 text-center">--</div>
        <div class="text-center text-xs text-gray-500 mt-2">
          WPM目安: <span data-result-target="wpm">--</span>
        </div>
      </div>

      <%# ミス数 %>
      <div class="rounded-xl border border-gray-800 bg-gray-900 p-5">
        <div class="flex items-center gap-2 mb-3">
          <div class="w-8 h-8 rounded-full bg-gray-800 flex items-center justify-center">
            <svg class="w-4 h-4 text-red-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div class="text-xs font-bold text-gray-400">ミス数</div>
        </div>
        <div data-result-target="missCount" class="text-4xl font-bold text-gray-100 text-center">--</div>
      </div>

      <%# タイム %>
      <div class="rounded-xl border border-gray-800 bg-gray-900 p-5">
        <div class="flex items-center gap-2 mb-3">
          <div class="w-8 h-8 rounded-full bg-gray-800 flex items-center justify-center">
            <svg class="w-4 h-4 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <div class="text-xs font-bold text-gray-400">タイム</div>
        </div>
        <div data-result-target="elapsedTime" class="text-4xl font-bold text-gray-100 text-center">--:--</div>
      </div>
    </div>

    <%# ミス位置ヒートマップ %>
    <div data-result-target="missHeatmap"
         class="hidden bg-gray-900 border border-gray-800 rounded-xl p-5 mb-6">
      <div class="flex items-baseline justify-between mb-2">
        <h3 class="text-sm font-bold text-gray-300">ミスした箇所</h3>
        <p class="text-xs text-gray-500">赤いハイライトが濃いほど何度もミスした箇所です</p>
      </div>
      <div data-result-target="heatmapBody"
           class="font-mono text-sm text-gray-300 whitespace-pre-wrap break-words leading-relaxed max-h-[200px] overflow-auto bg-gray-800 rounded-lg p-3"></div>
    </div>

    <%# 記事タイトル（全幅） %>
    <div data-result-target="articleTitle"
         class="hidden bg-gray-900 border border-gray-800 border-l-4 border-l-green-600 rounded-r-lg px-5 py-3 mb-6">
      <p class="text-xs font-bold text-gray-400 mb-1">練習した記事</p>
      <p data-result-target="articleTitleText" class="text-base font-bold text-gray-100"></p>
    </div>

    <%# 「この記録を保存する」ボタン（途中終了 + ログイン時に表示） %>
    <div data-result-target="saveButton" class="hidden flex flex-col items-center mb-6 gap-2">
      <p class="text-sm text-gray-400 mb-3">
        ※この記録はまだ保存されていません。
      </p>
      <button type="button"
              data-action="click->result#saveManually"
              class="inline-flex items-center gap-2 rounded-lg bg-green-500 hover:bg-green-700 px-6 py-3 font-bold text-gray-950 text-sm">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
        </svg>
        この記録を保存する
      </button>
    </div>

    <%# 主アクション（grid 2列で等幅）%>
    <div class="grid grid-cols-2 gap-3 mb-4">
      <%= link_to typing_path,
          class: "inline-flex items-center justify-center gap-2 rounded-lg bg-green-500 hover:bg-green-700 px-6 py-3 font-bold text-gray-950 shadow-sm" do %>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        同じテキストで再度練習
      <% end %>

      <button
        type="button"
        data-action="click->result#goToTop"
        class="inline-flex items-center justify-center gap-2 rounded-lg bg-gray-800 border border-gray-700 hover:bg-gray-700 px-6 py-3 font-bold text-gray-300 shadow-sm">
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
        異なるテキストで練習
      </button>
    </div>

    <%# 補助アクション（共有系 + 履歴ナビ） %>
    <div class="flex justify-center items-center gap-3">
      <button
        type="button"
        data-action="click->result#shareOnX"
        class="inline-flex items-center gap-2 rounded-lg border border-gray-700 px-4 py-2 text-sm font-bold text-gray-400 hover:bg-gray-800 hover:text-green-500 hover:border-gray-600 transition-colors">
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
          <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
        </svg>
        Xで共有
      </button>

      <button
        type="button"
        data-action="click->result#copyResult"
        class="inline-flex items-center gap-2 rounded-lg border border-gray-700 px-4 py-2 text-sm font-bold text-gray-400 hover:bg-gray-800 hover:text-green-500 hover:border-gray-600 transition-colors">
        <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
        </svg>
        結果をコピー
      </button>

      <% if user_signed_in? %>
        <%= link_to typing_histories_path(tab: :summary),
            class: "inline-flex items-center gap-2 rounded-lg border border-gray-700 px-4 py-2 text-sm font-bold text-gray-400 hover:bg-gray-800 hover:text-green-500 hover:border-gray-600 transition-colors" do %>
          <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
          履歴を見る
        <% end %>
      <% end %>
    </div>

  </div>

  <%# 未ログイン（スキップ）- 外枠カードの外に配置 %>
  <div data-result-target="saveSkipped" class="hidden max-w-2xl mx-auto mt-6 rounded-xl bg-gray-900 border border-gray-800 p-5 flex items-center justify-between gap-4">
    <div>
      <p class="font-bold text-gray-100">今回の結果を記録しませんか？</p>
      <p class="text-xs text-gray-400 mt-1">ログインまたは新規登録すると、今の結果が自動で保存されます</p>
    </div>
    <div class="flex gap-2 shrink-0">
      <%= link_to "ログイン", new_user_session_path,
          class: "rounded-lg bg-green-500 px-5 py-2 font-bold text-gray-950 text-sm hover:bg-green-700" %>
      <%= link_to "新規登録", new_user_registration_path,
          class: "rounded-lg bg-gray-800 border border-green-700 px-5 py-2 font-bold text-green-500 text-sm hover:bg-gray-700" %>
    </div>
  </div>

</div>
