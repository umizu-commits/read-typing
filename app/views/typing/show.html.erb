<div data-controller="typing" class="h-[calc(100vh-128px)] overflow-hidden py-3 -mr-5">
  <div class="grid h-full grid-cols-[1fr_320px] gap-6 overflow-hidden">
    <section class="relative overflow-hidden rounded-xl border border-gray-200 bg-white p-5 shadow-sm flex flex-col gap-3">

      <%#  入力ウィンドウ %>
      <div class="rounded-lg border border-gray-200 bg-gray-50 p-3">
        <div class="text-xs font-bold text-gray-500">
          入力文字
        </div>
        <div
          data-typing-target="typedWindow"
          class="font-mono text-sm text-gray-900 whitespace-pre-wrap break-all min-h-[2rem]"
        ></div>
      </div>


      <%# テキスト表示エリア %>
      <p
        data-typing-target="text"
        class="flex-1 overflow-auto whitespace-pre-wrap break-words text-lg font-semibold leading-relaxed text-gray-800 cursor-text"
        data-action="click->typing#focusInput"
      >
      </p>

      <textarea
        data-typing-target="input"
        data-action="keydown->typing#handleKeydown compositionstart->typing#handleCompositionStart compositionupdate->typing#handleCompositionUpdate compositionend->typing#handleCompositionEnd"
        class="fixed opacity-0 w-full h-px overflow-hidden resize-none"
        autocomplete="off"
        spellcheck="false"></textarea>
    </section>

    <%# 右側エリア %>
    <aside class="flex h-full flex-col items-end justify-between overflow-hidden">

      <%# 上グループ: hint + タイマー %>
      <div class="flex flex-col gap-2">
        <div
          data-typing-target="hint"
          class="w-[290px] rounded-xl bg-blue-50 border border-blue-200 p-5 text-center text-sm text-blue-600">
          最初の文字を入力すると<br>タイマーが開始されます
        </div>

        <div class="w-[290px] rounded-xl bg-white p-5 text-center shadow-sm">
          <div class="text-xs font-bold text-gray-500">
            経過時間
          </div>
          <div
            data-typing-target="timer"
            class="mt-1 font-mono text-2xl font-bold text-gray-900"
          >
            00:00
          </div>
        </div>
      </div>

      <%# 進捗 %>
      <div class="w-[290px] rounded-xl bg-white p-5 shadow-sm">
        <div class="flex justify-between text-xs font-bold text-gray-500 mb-2">
          <span>進捗</span>
          <span>
            <span data-typing-target="progressText">0</span>/
            <span data-typing-target="totalText">0</span>文字
          </span>
        </div>
        <div class="w-full bg-gray-200 rounded-full h-2">
          <div data-typing-target="progressBar"
               class="bg-blue-400 h-2 rounded-full transition-all duration-150"
               style="width: 0%"></div>
        </div>
      </div>

      <%# 下グループ: ボタン2つ %>
      <div class="flex flex-col gap-2">
        <button
          type="button"
          data-action="click->typing#reset"
          class="w-[290px] rounded-lg bg-white border border-gray-300 px-6 py-4 font-bold text-gray-700 shadow-sm hover:bg-gray-50">
          再挑戦する
        </button>

        <button
          type="button"
          data-action="click->typing#endPractice"
          class="w-[290px] rounded-lg bg-blue-400 px-6 py-4 font-bold text-white shadow-sm hover:bg-blue-500">
          タイピングを終了する
        </button>
      </div>

    </aside>
  </div>
</div>