<% content_for :title, "タイピング練習 | ReadTyping" %>
<% content_for :og_title, "タイピング練習 | ReadTyping" %>
<% content_for :og_description, "興味のある記事でタイピング練習を行います。" %>
<% content_for :twitter_title, "タイピング練習 | ReadTyping" %>

<% if @typing_text %>
  <script nonce="<%= content_security_policy_nonce %>">
    sessionStorage.setItem("typing_text", <%= raw @typing_text.to_json %>);
    sessionStorage.setItem("article_title", <%= raw (@article_title || "").to_json %>);
  </script>
<% end %>

<div data-controller="typing" class="h-[calc(100vh-112px)] overflow-hidden py-3 -mr-5">
  <div class="grid h-full grid-cols-[1fr_320px] grid-rows-[1fr_auto] gap-6 overflow-hidden">
    <section class="relative overflow-hidden rounded-xl border border-gray-800 bg-gray-900 p-5 shadow-sm flex flex-col gap-3">

      <%#  入力ウィンドウ %>
      <div class="rounded-lg border border-gray-700 bg-gray-800 p-3">
        <div class="text-xs font-bold text-gray-400">
          入力中
        </div>
        <div
          data-typing-target="typedWindow"
          class="font-mono text-sm text-gray-100 whitespace-pre-wrap break-all min-h-[2rem]"
        ></div>
      </div>

      <%# テキスト表示エリア %>
      <p
        data-typing-target="text"
        class="flex-1 overflow-auto whitespace-pre-wrap break-words text-lg font-semibold leading-relaxed text-gray-100 cursor-text"
        data-action="click->typing#focusInput"
      >
        <%= @typing_text %>
      </p>

      <textarea
        data-typing-target="input"
        data-action="keydown->typing#handleKeydown compositionstart->typing#handleCompositionStart compositionupdate->typing#handleCompositionUpdate compositionend->typing#handleCompositionEnd"
        class="fixed opacity-0 w-full h-px overflow-hidden resize-none"
        autocomplete="off"
        spellcheck="false"></textarea>
    </section>

    <%# 右側エリア %>
    <aside class="row-span-2 flex h-full flex-col items-end justify-between overflow-hidden">

      <%# 上部グループ: 情報カード（タイトル + タイマー + 進捗） %>
      <div class="flex flex-col gap-3 w-[290px]">

        <%# 記事タイトル %>
        <div data-typing-target="title"
             class="rounded-xl bg-gray-900 border border-gray-800 p-5 text-sm text-gray-300 font-bold shadow-sm hidden">
        </div>

        <%# タイマーカード（hint内蔵） %>
        <div class="rounded-xl bg-gray-900 border border-gray-800 p-5 text-center shadow-sm">
          <div class="text-xs font-bold text-gray-400">
            経過時間
          </div>
          <div data-typing-target="timer"
               class="mt-1 font-mono text-2xl font-bold text-gray-100">
            00:00
          </div>
          <p data-typing-target="hint"
             class="mt-2 text-xs text-gray-500">
            最初の文字を入力するとタイマーが開始されます
          </p>
        </div>

        <%# 進捗 %>
        <div class="rounded-xl bg-gray-900 border border-gray-800 p-6 shadow-sm">
          <div class="flex justify-between text-xs font-bold text-gray-400 mb-3">
            <span>進捗</span>
            <span>
              <span data-typing-target="progressText">0</span>/<span data-typing-target="totalText">0</span>文字
            </span>
          </div>
          <div class="w-full bg-gray-700 rounded-full h-3 mb-3">
            <div data-typing-target="progressBar"
                 class="bg-green-600 h-3 rounded-full transition-all duration-150"
                 style="width: 0%"></div>
          </div>
          <div class="text-center">
            <span data-typing-target="progressPercent" class="font-mono text-3xl font-bold text-gray-100">0</span>
            <span class="font-mono text-2xl font-bold text-gray-500">%</span>
          </div>
        </div>
      </div>

      <%# キーボードビジュアライザー %>
      <div class="w-[290px] rounded-xl bg-gray-800 border border-gray-700 p-3 flex flex-col gap-2">
      </div>

      <%# 操作ボタングループ %>
      <div class="w-[290px] rounded-xl bg-gray-800 border border-gray-700 p-3 flex flex-col gap-2">
        <button
          type="button"
          data-action="click->typing#toggleSkipMode"
          data-typing-target="skipModeButton"
          class="rounded-lg bg-gray-900 border border-gray-700 px-4 py-2 text-sm font-bold text-gray-300 hover:bg-gray-800">
          スキップモード: OFF
        </button>

        <button
          type="button"
          data-action="click->typing#reset"
          class="rounded-lg bg-gray-900 border border-gray-700 px-4 py-2 text-sm font-bold text-gray-300 hover:bg-gray-800">
          再挑戦する
        </button>

        <button
          type="button"
          data-action="click->typing#endPractice"
          class="rounded-lg bg-gray-900 border border-red-800 px-4 py-2 text-sm font-bold text-red-400 hover:bg-red-950">
          タイピングを終了する
        </button>
      </div>
    </aside>

    <div class="rounded-xl bg-gray-900 border border-gray-800 p-4 shadow-sm overflow-hidden">
      <%= render 'typing/keyboard' %>
    </div>
  </div>
</div>
